rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return signedInWithGoogle()
        && request.auth.token.email.lower() == 'admin@example.com';
    }

    match /grade_documents/{documentId} {
      allow read, write: if isAdmin();
    }

    match /student_views/{email} {
      allow get: if isAdmin()
        || (signedInWithGoogle() && request.auth.token.email.lower() == email);
      allow list, write: if isAdmin();
    }
  }
}
